{
  "name": "quiz-app",
  "version": "1.0.0",
  "description": "Quiz Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node database/migrate.js full",
    "db:schema": "node database/migrate.js schema",
    "db:migrate": "node database/migrate.js migrate",
    "db:test": "node -e \"const {getDb,DB_PATH}=require('./config/database'); getDb().prepare('SELECT 1').get(); console.log('✅ SQLite bağlantısı OK:', DB_PATH);\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
